<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label  Content="ФИО"  Width="auto" Grid.Row="0" HorizontalAlignment="Right"/>
            <Label  Content="Гендер" Width="auto" Grid.Row="2" HorizontalAlignment="Right"/>
            <Label  Content="Ваша цель" Width="auto" Grid.Row="6" HorizontalAlignment="Right"/>
            <Label  Content="Дата рождения" Width="auto" Grid.Row="1" HorizontalAlignment="Right"/>
            <Label  Content="Медицинские противопоказания" Width="auto" Grid.Row="3" HorizontalAlignment="Right"/>
            <Label  Content="Телефон" Width="auto" Grid.Row="7" HorizontalAlignment="Right"/>
            <TextBox x:Name="TextBoxFIO" Background="Transparent"  TextWrapping="Wrap" ToolTip="Введите фио" Margin="5" Grid.Row="0"  Grid.Column="1"/>
            <ScrollViewer Margin="5" Grid.Row="3" Grid.RowSpan="3"  Grid.Column="1" CanContentScroll="True">
                <TextBox x:Name="TextBoxMN" Background="Transparent"  TextWrapping="Wrap" ToolTip="Введите противопоказания"/>
            </ScrollViewer>
            <TextBox x:Name="Number" Background="Transparent" ToolTip="Введите телефон" Grid.Column="1" Margin="5" Grid.Row="7"/>
            <ComboBox x:Name="СomboBxGender" Grid.Column="1" ToolTip="Выберите гендер" Grid.Row="2" Height="37" Margin="5">
                <ComboBoxItem Content="Мужчина"></ComboBoxItem>
                <ComboBoxItem Content="Женщина"></ComboBoxItem>
            </ComboBox>
            <DatePicker Name="birthday" Grid.Column="1" Margin="5" Grid.Row="1"></DatePicker>
            <ComboBox x:Name="СomboBxGoal" Grid.Column="1" ToolTip="Выберите цель" Grid.Row="6" Margin="5" DisplayMemberPath="Name" SelectedValuePath="GoalId"/>
            <Button x:Name="ButtonChange" Height="34" Content="Изменить"  Width="150" Margin="5" Grid.Row="8" Grid.Column="1" Click="ButtonChange_Click"></Button>
            <Button x:Name="ButtonChangePass" Height="34" Content="Изменить пароль"  Width="150" Margin="5" Grid.Row="9" Grid.Column="1"  Click="ButtonChangePass_Click"></Button>
            <Button x:Name="StyleButton" Height="34" Content="Изменить тему"  Width="150" Margin="5" Grid.Row="9" Grid.Column="0"  Click="StyleButton_Click"></Button>
            <ComboBox x:Name="StyleComboBox" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Id" Grid.Row="8" Grid.Column="0" Margin="5"></ComboBox>
        </Grid>
    </Grid>
</Page>

<Page x:Class="WpfApp1.Pages.DiagramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages" xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DiagramPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <WindowsFormsHost Grid.Row="1" Grid.ColumnSpan="4">
            <charts:Chart x:Name="ChartEnergyBalance">
                <charts:Chart.Legends>
                    <charts:Legend Name="MainLegend" Docking="Top" Alignment="Center">
                    </charts:Legend>
                </charts:Chart.Legends>
            </charts:Chart>
        </WindowsFormsHost>
        <Label Content="Тип диаграммы: " HorizontalAlignment="Right" VerticalAlignment="Center"></Label>
        <ComboBox Name="TypeDiagram" Margin="10" Grid.Column="1">
            <ComboBoxItem Content=""></ComboBoxItem>
        </ComboBox>
        <Button Name="wordButton" Content="Word" Grid.Column="3" Margin="10" Click="wordButton_Click"></Button>
        <Button Name="excelButton" Content="Excel" Grid.Column="2" Margin="10" Click="excelButton_Click"></Button>
    </Grid>
</Page>

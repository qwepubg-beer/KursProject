<Page x:Class="WpfApp1.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePassPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="MainFiels" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <Label Content="Логин" HorizontalAlignment="Center"></Label>
            <TextBox x:Name="TextBoxLogin" Background="Transparent"  TextWrapping="Wrap" ToolTip="Введите логин или почту" Height="34"  Width="134"/>
            <Label Content="Старый пароль" HorizontalAlignment="Center"></Label>
            <PasswordBox x:Name="PasswordBox" Background="Transparent" ToolTip="Введите пароль" Width="134" Height="32"  Grid.Column="1"/>
            <Label Content="Новый пароль" HorizontalAlignment="Center"></Label>
            <PasswordBox x:Name="PasswordBox2" Background="Transparent" ToolTip="Введите пароль" Width="134" Height="32"  Grid.Column="1"/>
            <Button x:Name="Conf" Height="34" Content="Подтвердить" ToolTip="Кнопка входа"  Width="120" Margin="5" Click="Conf_Click"/>
        </StackPanel>
    </Grid>
</Page>

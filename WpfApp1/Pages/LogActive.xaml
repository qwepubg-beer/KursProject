<Page x:Class="WpfApp1.Pages.LogActive"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LogActive">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <TextBlock Name="ChoosingActivty" Grid.Row="2"/>
        <Label Content="Введите количество минут:" Grid.Row="3"/>
        <TextBox Name="Quantity" Grid.Row="4" Margin="5"/>
        <Button Name="RecordBtn" Content="Записать" Grid.Row="5" Margin="5" Click="RecordBtn_Click"></Button>
        <ListBox x:Name="ActivityListBox"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="4" Grid.Row="1" Grid.Column="1" Grid.RowSpan="6">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding MET, StringFormat=Расход: {0}}"/>
                        <Button Name="ChooseFoodBtn" Height="25" Content="Выбрать" Click="ChooseFoodBtn_Click"></Button>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <ComboBox x:Name="SortComboBox" ToolTip="сортировка по расходу" Grid.Column="2" IsEditable="True" Margin="5">
            <ComboBoxItem Content="По расходу возрастание"></ComboBoxItem>
            <ComboBoxItem Content="По расходу убывание"></ComboBoxItem>
        </ComboBox>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="SearchBtn" Content="Поиск"  Grid.Column="0" Margin="5" Click="SearchBtn_Click"/>
            <Button Name="ResetBtn" Content="Сброс" Grid.Column="1" Margin="5" Click="ResetBtn_Click"/>
        </Grid>
        <TextBox Name="TextSearch" TextWrapping="Wrap" Text="" Grid.Column="0" Margin="8"/>
    </Grid>
</Page>

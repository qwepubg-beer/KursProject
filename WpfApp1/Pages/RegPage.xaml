<Page x:Class="WpfApp1.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label  Content="Введите логин"  Width="auto" Grid.Row="0"/>
            <Label  Content="Введите пароль"  Width="auto" Grid.Row="1"/>
            <Label  Content="Подтвердите пароль" Width="auto" Grid.Row="2"/>
            <Label  Content="Выбирите роль" Width="auto" Grid.Row="3"/>
            <Label  Content="Введите ФИО" Width="auto" Grid.Row="4"/>
            <TextBox x:Name="TextBoxLogin" Background="Transparent"  TextWrapping="Wrap" ToolTip="Введите логин или почту" Height="34"  Width="134" Margin="5" Grid.Row="0"  Grid.Column="1"/>
            <TextBox x:Name="TextBoxFio" Background="Transparent"  TextWrapping="Wrap" ToolTip="Введите логин или почту" Height="34"  Width="134" Margin="5" Grid.Row="4"  Grid.Column="1"/>
            <PasswordBox x:Name="PasswordBox" Background="Transparent" ToolTip="Введите пароль" Width="134" Height="32"  Grid.Column="1" Margin="5" Grid.Row="1"/>
            <PasswordBox x:Name="PasswordBox2" Background="Transparent" ToolTip="Введите пароль" Width="134" Height="32"  Grid.Column="1" Margin="5" Grid.Row="2"/>
            <ComboBox x:Name="comboBxRole" Grid.Column="1" ToolTip="Выберите роль" Grid.Row="3"  RenderTransformOrigin="0.144,0.522" Height="37" Margin="5">
                <ComboBoxItem Content="User" />
                <ComboBoxItem Content="Admin" />
            </ComboBox>
            <Button x:Name="ButtonEnter" Height="34" Content="Зарегистрироваться" ToolTip="Кнопка входа"  Width="150" Margin="5" Grid.Row="5" Grid.ColumnSpan="2"></Button>
        </Grid>
    </Grid>
</Page>

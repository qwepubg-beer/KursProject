<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Frame Name="MainFrame" Grid.RowSpan="7" Grid.Column="1" NavigationUIVisibility="Hidden"></Frame>
        <Grid Name="User_menu" Grid.Row="1" Grid.RowSpan="4"  Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Name="Account" Click="Account_Click" Grid.Row="0"></Button>
            <Button Name="Records" Click="Records_Click" Grid.Row="1"></Button>
            <Button Name="Measurement" Click="Measurement_Click" Grid.Row="2"></Button>
            <Button Name="Diagrams" Click="Diagrams_Click" Grid.Row="3"></Button>
        </Grid>
        <Grid Name="Admin_menu" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Name="Products" Click="Account_Click" Grid.Row="0"></Button>
            <Button Name="Users" Click="Users_Click" Grid.Row="1"></Button>
        </Grid>
        <Button Name="Back" Click="Back_Click"> </Button>
        <Button Name="Exit" Grid.Row="7" Click="Window_Closing" ></Button>
    </Grid>
</Window>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"  Color="#252526"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"      Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"    Color="#AAAAAA"/>
    <SolidColorBrush x:Key="BorderBrush"           Color="#3F3F46"/>

    <SolidColorBrush x:Key="AccentBrush"           Color="#4C9EEB"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#3B82C4"/>
    <SolidColorBrush x:Key="AccentTextBrush"       Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"      Color="#4A4A4E"/>
    <SolidColorBrush x:Key="ButtonTextBrush"       Color="#F0F0F0"/>
    <FontFamily x:Key="AppFontFamily">Open Sans</FontFamily>
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style TargetType="Page">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>
    <Style TargetType="Frame">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="NavigationUIVisibility" Value="Hidden"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

</ResourceDictionary>